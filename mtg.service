[Unit]
Description=mtg - Highly opinionated MTPROTO proxy for Telegram

StartLimitIntervalSec=0

[Install]
WantedBy=multi-user.target

[Service]
EnvironmentFile=/etc/sysconfig/mtg

Type=simple
User=mtg
Group=mtg

LimitNOFILE=1024000
LogRateLimitIntervalSec=0

ExecStart=/usr/bin/mtg $MTG_COMMAND

AmbientCapabilities=CAP_NET_BIND_SERVICE

Restart=always
RestartSec=1
